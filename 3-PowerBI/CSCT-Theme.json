{
  "name": "Customer Success Control Tower",
  "dataColors": [
    "#B11F4B",
    "#242424",
    "#0078D4",
    "#16A34A",
    "#F59E0B",
    "#DC2626",
    "#6F6F6F",
    "#9A1A41",
    "#4DA6FF",
    "#919191"
  ],
  "background": "#FFFFFF",
  "foreground": "#242424",
  "tableAccent": "#B11F4B",
  "good": "#16A34A",
  "neutral": "#F59E0B",
  "bad": "#DC2626",
  "maximum": "#DC2626",
  "center": "#F59E0B",
  "minimum": "#16A34A",
  "null": "#DEDEDE",
  "hyperlink": "#0078D4",
  "visitedHyperlink": "#9A1A41",
  "textClasses": {
    "callout": {
      "fontSize": 28,
      "fontFace": "Segoe UI Semibold",
      "color": "#242424"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#242424"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#242424"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#5C5C5C"
    }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F7F4EF"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F7F4EF"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#DEDEDE"
              }
            },
            "radius": 12
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 10,
            "bottom": 10,
            "left": 12,
            "right": 12
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#242424"
              }
            },
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#242424"
              }
            },
            "fontSize": 26
          }
        ],
        "categoryLabels": [
          {
            "color": {
              "solid": {
                "color": "#5C5C5C"
              }
            },
            "fontSize": 10
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#5C5C5C"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FCFBF8"
              }
            }
          }
        ],
        "grid": [
          {
            "gridHorizontalColor": {
              "solid": {
                "color": "#EDEDED"
              }
            }
          }
        ]
      }
    }
  }
}